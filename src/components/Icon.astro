---
/* Selbst gezeichnete Strich-Icons (einheitlich 1.75 px, 24er Raster). */
interface Props {
  name: 'clear' | 'sell' | 'store' | 'excavator' | 'shelf' | 'truck' | 'office' | 'phone' | 'pin' | 'clock' | 'arrow';
  class?: string;
}
const { name, class: className = 'h-6 w-6' } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'clear' && (
    <>
      <path d="M3 21V9l9-5 9 5v12" />
      <path d="M8 21v-7h8v7" />
      <path d="M10.5 17.5h3" />
    </>
  )}
  {name === 'sell' && (
    <>
      <path d="M3 12V4h8l10 10-8 8L3 12Z" />
      <circle cx="7.5" cy="8.5" r="1.5" />
    </>
  )}
  {name === 'store' && (
    <>
      <rect x="3" y="4" width="18" height="5" rx="1" />
      <path d="M5 9v11h14V9" />
      <path d="M10 13h4" />
    </>
  )}
  {name === 'excavator' && (
    <>
      <path d="M2 19h11" />
      <rect x="3" y="12" width="9" height="4" rx="1" />
      <path d="M6 12V9h4l2 3" />
      <path d="M12 12l4-6 4 2-1 5" />
      <path d="M19 13l2 3h-4" />
      <circle cx="5" cy="19" r="1" />
      <circle cx="10" cy="19" r="1" />
    </>
  )}
  {name === 'shelf' && (
    <>
      <path d="M4 3v18M20 3v18" />
      <path d="M4 8h16M4 14h16M4 20h16" />
      <rect x="6" y="10" width="4" height="4" />
      <rect x="12" y="4" width="5" height="4" />
      <rect x="13" y="16" width="4" height="4" />
    </>
  )}
  {name === 'truck' && (
    <>
      <path d="M2 6h11v10H2z" />
      <path d="M13 9h4l4 4v3h-8" />
      <circle cx="6" cy="17.5" r="1.8" />
      <circle cx="17" cy="17.5" r="1.8" />
    </>
  )}
  {name === 'office' && (
    <>
      <path d="M7 4h10v8H7z" />
      <path d="M5 12h14" />
      <path d="M12 12v5" />
      <path d="M8 21l4-4 4 4" />
    </>
  )}
  {name === 'phone' && (
    <path d="M4 5c0-1 .8-2 2-2h2l1.5 4-2 1.5a12 12 0 0 0 7 7l1.5-2 4 1.5v2c0 1.2-1 2-2 2C10.5 19 5 13.5 4 5Z" />
  )}
  {name === 'pin' && (
    <>
      <path d="M12 21s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z" />
      <circle cx="12" cy="9" r="2.5" />
    </>
  )}
  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M12 7v5l3 2" />
    </>
  )}
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
</svg>
