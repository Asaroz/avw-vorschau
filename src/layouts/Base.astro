---
import '@fontsource-variable/inter';
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { company } from '../data/site';
import { withBase } from '../lib/url';

interface Props {
  title?: string;
}
const { title } = Astro.props;
const pageTitle = title ? `${title} · ${company.legal}` : `${company.short} – Beräumung, Verwertung & Einlagerung · Rees`;
---

<!doctype html>
<!-- ENTWURF für AVW – Alden Vermarktung West GmbH. Nicht die offizielle Website. -->
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content="AVW – Alden Vermarktung West GmbH aus Rees: Beräumung, Verwertung und Einlagerung für Insolvenzverwalter und Betriebe am Niederrhein. Verkauf von Maschinen, Fahrzeugen und Betriebsausstattung." />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#181b1f" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%23181b1f'/%3E%3Ctext x='16' y='21.5' font-family='Arial Narrow,Arial,sans-serif' font-weight='800' font-size='13' fill='%23ffc928' text-anchor='middle'%3EAVW%3C/text%3E%3C/svg%3E" />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-signal-400 focus:px-4 focus:py-2 focus:text-asphalt-950">Zum Inhalt springen</a>

    <div class="bg-signal-400 text-center text-xs font-semibold text-asphalt-950">
      <p class="container-page py-1.5">Entwurf – Texte und Bilder sind noch nicht abgestimmt.</p>
    </div>

    <header class="sticky top-0 z-40 border-b border-white/10 bg-asphalt-900/95 text-white backdrop-blur">
      <div class="container-page flex items-center justify-between gap-4 py-3">
        <a href={withBase('/')} class="flex items-center gap-3" aria-label={`${company.legal} – Startseite`}>
          <span class="rounded-sm bg-signal-400 px-2 py-0.5 font-[family-name:var(--font-display)] text-2xl font-extrabold leading-tight text-asphalt-950 [font-stretch:78%]">{company.short}</span>
          <span class="hidden text-sm font-semibold leading-tight text-steel-100 sm:block">{company.name}<br /><span class="font-normal text-steel-300">Insolvenzverwertung · {company.city}</span></span>
        </a>
        <nav aria-label="Hauptnavigation" class="hidden md:block">
          <ul class="flex items-center gap-1 text-sm font-semibold">
            <li><a class="rounded px-3 py-2 text-steel-100 hover:text-signal-400" href={withBase('/#leistungen')}>Leistungen</a></li>
            <li><a class="rounded px-3 py-2 text-steel-100 hover:text-signal-400" href={withBase('/#angebote')}>Angebote</a></li>
            <li><a class="rounded px-3 py-2 text-steel-100 hover:text-signal-400" href={withBase('/#kontakt')}>Kontakt</a></li>
          </ul>
        </nav>
        <a href={`tel:${company.mobileHref}`} class="btn btn-signal min-h-11 px-4 text-sm">
          <Icon name="phone" class="h-4 w-4" />
          <span>Anrufen</span>
        </a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="bg-asphalt-950 text-steel-300">
      <div class="container-page flex flex-col gap-4 py-10 text-sm sm:flex-row sm:items-center sm:justify-between">
        <p>© {new Date().getFullYear()} {company.legal} · {company.street}, {company.zip} {company.city}</p>
        <nav aria-label="Rechtliches" class="flex gap-5">
          <a class="inline-block py-2 hover:text-white" href={withBase('/impressum/')}>Impressum</a>
          <a class="inline-block py-2 hover:text-white" href={withBase('/impressum/#datenschutz')}>Datenschutz</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
