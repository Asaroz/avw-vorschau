---
import '@fontsource-variable/inter';
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { company, links } from '../data/site';
import { withBase } from '../lib/url';

const navItems = [
  { id: 'leistungen', label: 'Leistungen' },
  { id: 'angebote', label: 'Angebote' },
  { id: 'kontakt', label: 'Kontakt' },
];

interface Props {
  title?: string;
}
const { title } = Astro.props;
const pageTitle = title ? `${title} · ${company.legal}` : `${company.short} – Beräumung, Verwertung & Einlagerung · Rees`;
---

<!doctype html>
<!-- ENTWURF für AVW – Alden Vermarktung West GmbH. Nicht die offizielle Website. -->
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content="AVW – Alden Vermarktung West GmbH aus Rees: Beräumung, Verwertung und Einlagerung für Insolvenzverwalter und Betriebe am Niederrhein. Verkauf von Maschinen, Fahrzeugen und Betriebsausstattung." />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#181b1f" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%23181b1f'/%3E%3Ctext x='16' y='21.5' font-family='Arial Narrow,Arial,sans-serif' font-weight='800' font-size='13' fill='%23ffc928' text-anchor='middle'%3EAVW%3C/text%3E%3C/svg%3E" />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-signal-400 focus:px-4 focus:py-2 focus:text-asphalt-950">Zum Inhalt springen</a>

    <div class="bg-asphalt-950 text-center text-xs font-semibold text-signal-400">
      <p class="container-page py-1.5">Entwurf – Texte noch nicht abgestimmt.</p>
    </div>

    <header class="sticky top-0 z-40 border-b border-white/10 bg-asphalt-900/95 text-white backdrop-blur">
      <div class="container-page flex items-center justify-between gap-4 py-2.5 md:py-3">
        <a href={withBase('/')} class="flex min-h-11 items-center gap-3" aria-label={`${company.legal} – Startseite`}>
          <span class="rounded-sm bg-signal-400 px-2 py-0.5 font-[family-name:var(--font-display)] text-2xl font-extrabold leading-tight text-asphalt-950 [font-stretch:78%]">{company.short}</span>
          {/* Auch mobil sichtbar: „AVW" allein sagt Erstbesuchern nichts. */}
          <span class="text-sm font-semibold leading-tight text-steel-100">{company.name}<br /><span class="font-normal text-steel-300">Insolvenzverwertung · {company.city}</span></span>
        </a>
        <nav aria-label="Hauptnavigation" class="hidden md:block">
          <ul class="flex items-center gap-1 text-sm font-semibold">
            {navItems.map((n) => (
              <li><a class="inline-flex min-h-11 items-center rounded px-3 text-steel-100 hover:text-signal-400" href={withBase(`/#${n.id}`)}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
        <a href={`tel:${company.mobileHref}`} class="btn btn-signal hidden min-h-11 px-4 text-sm md:inline-flex">
          <Icon name="phone" class="h-4 w-4" />
          <span>Anrufen</span>
        </a>
      </div>
      {/* Mobil: Abschnitte als Leiste unter dem Kopf statt verstecktem Menü */}
      <nav aria-label="Abschnitte" class="border-t border-white/10 md:hidden">
        <ul class="container-page flex justify-between text-sm font-semibold">
          {navItems.map((n) => (
            <li><a class="inline-flex min-h-11 items-center text-steel-100 active:text-signal-400" href={withBase(`/#${n.id}`)}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    {/* Mobil: Aktionen im Daumenbereich */}
    <div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2 border-t border-white/10 bg-asphalt-900/95 px-3 py-2.5 backdrop-blur md:hidden" style="padding-bottom: max(0.625rem, env(safe-area-inset-bottom));">
      <a href={`tel:${company.mobileHref}`} class="btn btn-signal min-h-12 px-3 text-sm">
        <Icon name="phone" class="h-4 w-4" />
        Anrufen
      </a>
      <a href={links.kleinanzeigen} target="_blank" rel="noopener" class="btn btn-ghost-dark min-h-12 px-3 text-sm">
        Angebote
        <Icon name="external" class="h-4 w-4" />
        <span class="sr-only">(öffnet Kleinanzeigen in neuem Tab)</span>
      </a>
    </div>

    <footer class="bg-asphalt-950 pb-20 text-steel-300 md:pb-0">
      <div class="container-page flex flex-col gap-4 py-10 text-sm sm:flex-row sm:items-center sm:justify-between">
        <p>© {new Date().getFullYear()} {company.legal} · {company.street}, {company.zip} {company.city} · <a class="inline-flex min-h-11 items-center hover:text-white" href={`tel:${company.phoneHref}`}>{company.phoneLabel}</a></p>
        <nav aria-label="Rechtliches" class="flex gap-5">
          <a class="inline-flex min-h-11 items-center hover:text-white" href={withBase('/impressum/')}>Impressum</a>
          <a class="inline-flex min-h-11 items-center hover:text-white" href={withBase('/impressum/#datenschutz')}>Datenschutz</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
