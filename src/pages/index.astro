---
/* Startseite AVW (Entwurf). Single Page: Einstieg, Leistungen, Ablauf für
   Insolvenzverwalter, Angebote (Links in die Shops), Kontakt.

   Angebote: KEIN automatischer Abruf – Kleinanzeigen bietet keine Schnittstelle
   und verbietet Einbetten/Auslesen. Die Kacheln sind feste Warengruppen und
   verlinken in den Kleinanzeigen-Shop; gekauft wird dort. (eBay ließe sich
   später über die offizielle Browse-API automatisch ergänzen.) */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { company, links, services, categories } from '../data/site';

const steps = [
  { title: 'Anfrage', text: 'Sie schildern kurz Objekt, Umfang und Zeitrahmen – telefonisch oder per Nachricht.' },
  { title: 'Besichtigung & Angebot', text: 'Wir sehen uns die Räume und das Inventar an und nennen Ihnen einen festen Betrag.' },
  { title: 'Beräumung & Verwertung', text: 'Wir räumen termingerecht und übernehmen die Verwertung der Gegenstände.' },
];
---

<Base>
  <!-- ============================ EINSTIEG ============================ -->
  <section class="relative overflow-hidden bg-asphalt-900 text-white">
    <div class="container-page relative grid items-center gap-12 py-16 sm:py-20 lg:grid-cols-[1.25fr_0.75fr] lg:py-28">
      <div>
        <h1 class="text-5xl !text-white sm:text-6xl lg:text-7xl">
          Beräumen. Verwerten. <span class="text-signal-400">Einlagern.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-steel-100">
          Für Insolvenzverwalter und Betriebe am Niederrhein übernehmen wir Betriebs-
          und Geschäftsausstattung, Maschinen und Fahrzeuge – und bringen sie wieder in
          Umlauf. Seit {company.since}, aus {company.city}.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href="#angebote" class="btn btn-signal">
            Aktuelle Angebote
            <Icon name="arrow" class="h-5 w-5" />
          </a>
          <a href="#kontakt" class="btn btn-ghost-dark">Beräumung anfragen</a>
        </div>
      </div>

      <!-- Inventar-Anhänger als Visitenkarte -->
      <div class="mx-auto w-full max-w-xs lg:max-w-sm" aria-hidden="true">
        <div class="tag-wrap hero-tag">
          <div class="tag text-asphalt-900">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted">Inventar-Nr.</p>
            <p class="font-[family-name:var(--font-display)] text-4xl font-extrabold [font-stretch:78%]">AVW-{company.since}</p>
            <div class="mt-4 space-y-2 border-t border-dashed border-steel-300 pt-4 text-sm">
              <p class="flex justify-between gap-4"><span class="text-muted">Sitz</span><span class="font-semibold">{company.city}</span></p>
              <p class="flex justify-between gap-4"><span class="text-muted">Warenstandort</span><span class="font-semibold">Emmerich</span></p>
              <p class="flex justify-between gap-4"><span class="text-muted">Zustand</span><span class="font-semibold">sofort verfügbar</span></p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="h-2 bg-[repeating-linear-gradient(-45deg,var(--color-signal-400)_0_14px,var(--color-asphalt-950)_14px_28px)]" aria-hidden="true"></div>
  </section>

  <!-- ============================ LEISTUNGEN ============================ -->
  <section id="leistungen" class="scroll-mt-20 py-16 sm:py-24">
    <div class="container-page grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div>
        <h2 class="text-4xl sm:text-5xl">Was wir für Sie übernehmen</h2>
        <p class="mt-5 max-w-md text-lg text-muted">
          Von der leeren Halle bis zum verkauften Gabelstapler: alles aus einer Hand,
          ohne dass Sie sich um Abtransport oder Käufer kümmern müssen.
        </p>
      </div>
      <ul class="divide-y divide-steel-300 border-y border-steel-300">
        {services.map((s) => (
          <li class="grid grid-cols-[auto_1fr] gap-5 py-7">
            <span class="flex h-12 w-12 items-center justify-center rounded-md bg-asphalt-900 text-signal-400">
              <Icon name={s.icon} />
            </span>
            <div>
              <h3 class="text-2xl sm:text-3xl">{s.title}</h3>
              <p class="mt-2 max-w-xl text-asphalt-700">{s.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===================== FÜR INSOLVENZVERWALTER ===================== -->
  <section class="bg-asphalt-800 py-16 text-white sm:py-20">
    <div class="container-page">
      <h2 class="max-w-2xl text-4xl !text-white sm:text-5xl">So läuft eine Beräumung ab</h2>
      <p class="mt-5 max-w-2xl text-lg text-steel-100">
        Viele Insolvenzverwalter arbeiten seit Jahren mit uns zusammen. Für neue
        Auftraggeber sieht der Weg so aus:
      </p>
      <ol class="mt-12 grid gap-8 md:grid-cols-3 md:gap-6">
        {steps.map((step, i) => (
          <li class="relative border-t-4 border-signal-400 pt-5">
            <span class="sr-only">Schritt {i + 1}: </span>
            <h3 class="text-2xl !text-white">{step.title}</h3>
            <p class="mt-2 text-steel-100">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============================ ANGEBOTE ============================ -->
  <section id="angebote" class="scroll-mt-20 bg-steel-100 py-16 sm:py-24">
    <div class="container-page">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <h2 class="text-4xl sm:text-5xl">Aktuelle Angebote</h2>
          <p class="mt-5 max-w-2xl text-lg text-muted">
            Unser Bestand wechselt laufend – immer wieder kommen neue Posten aus
            Insolvenzen und Firmenauflösungen dazu. Alle verfügbaren Angebote finden Sie
            in unserem Kleinanzeigen-Shop.
          </p>
        </div>
        <a href={links.kleinanzeigen} target="_blank" rel="noopener" class="btn btn-dark self-start lg:self-auto">
          Zum Kleinanzeigen-Shop
          <Icon name="arrow" class="h-5 w-5" />
        </a>
      </div>

      <!-- Stange, an der die Anhänger hängen -->
      <div class="relative mt-14">
        <div class="absolute inset-x-0 top-0 h-2 rounded-full bg-asphalt-700 shadow-[0_3px_0_rgb(17_19_22/0.15)]" aria-hidden="true"></div>
        <ul class="grid gap-x-6 gap-y-4 pt-1 sm:grid-cols-2 lg:grid-cols-4">
          {categories.map((c) => (
            <li class="tag-wrap">
              <a href={links.kleinanzeigen} target="_blank" rel="noopener" class="tag group h-full text-asphalt-900">
                <span class="flex items-start justify-between gap-3">
                  <h3 class="text-2xl">{c.title}</h3>
                  <Icon name={c.icon} class="mt-0.5 h-8 w-8 flex-none text-signal-600" />
                </span>
                <p class="mt-2 text-sm text-muted">{c.examples}</p>
                <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-bold">
                  <span class="text-link-signal">Im Shop ansehen</span>
                  <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="mt-12 flex flex-col gap-4 border-t border-steel-300 pt-8 sm:flex-row sm:items-center sm:justify-between">
        <p class="max-w-xl text-sm text-muted">
          Fragen, Verhandeln und Kaufen laufen direkt über Kleinanzeigen bzw. eBay –
          mit allen gewohnten Funktionen der Plattform.
        </p>
        <a href={links.ebay} target="_blank" rel="noopener" class="text-link-signal self-start text-asphalt-900 sm:self-auto">Auch auf eBay</a>
      </div>
    </div>
  </section>

  <!-- ============================ KONTAKT ============================ -->
  <section id="kontakt" class="scroll-mt-20 py-16 sm:py-24">
    <div class="container-page grid gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <h2 class="text-4xl sm:text-5xl">Sprechen Sie uns an</h2>
        <p class="mt-5 max-w-md text-lg text-muted">
          Ob Beräumung, Einlagerung oder Frage zu einem Angebot – am schnellsten geht es
          telefonisch.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={`tel:${company.mobileHref}`} class="btn btn-signal">
            <Icon name="phone" class="h-5 w-5" />
            {company.mobileLabel}
          </a>
          <a href={`tel:${company.phoneHref}`} class="btn border border-asphalt-700 text-asphalt-900 hover:bg-steel-100">
            {company.phoneLabel}
          </a>
        </div>
      </div>

      <dl class="grid gap-8 sm:grid-cols-2">
        <div>
          <dt class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-muted"><Icon name="pin" class="h-4 w-4" /> Firmensitz</dt>
          <dd class="mt-2 text-lg">{company.legal}<br />{company.street}<br />{company.zip} {company.city}</dd>
        </div>
        <div>
          <dt class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-muted"><Icon name="pin" class="h-4 w-4" /> Warenstandort</dt>
          <dd class="mt-2 text-lg">{company.stockCity}<br /><span class="text-base text-muted">Besichtigung nach Absprache</span></dd>
        </div>
        <div class="sm:col-span-2">
          <dt class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-muted"><Icon name="clock" class="h-4 w-4" /> Erreichbar</dt>
          <dd class="mt-2 max-w-sm space-y-1 text-lg">
            {company.hours.map((h) => (
              <p class="flex justify-between gap-6"><span>{h.day}</span><span class="tabular-nums">{h.time}</span></p>
            ))}
          </dd>
        </div>
      </dl>
    </div>
  </section>
</Base>

<style>
  /* Der Anhänger im Einstieg pendelt einmal sanft aus – einziger Bewegungsmoment. */
  .hero-tag .tag {
    animation: swing 2.4s cubic-bezier(0.16, 1, 0.3, 1) 0.3s both;
  }
  @keyframes swing {
    0% {
      transform: rotate(9deg);
    }
    35% {
      transform: rotate(-5deg);
    }
    65% {
      transform: rotate(2deg);
    }
    100% {
      transform: rotate(0);
    }
  }
  .hero-tag .tag-wrap::before,
  .hero-tag::before {
    background: var(--color-steel-300);
  }
</style>
